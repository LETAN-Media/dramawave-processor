[Unit]
Description=Bilibili Processor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bilibili-processor
EnvironmentFile=/root/bilibili-processor/.env
ExecStart=/root/bilibili-processor/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
