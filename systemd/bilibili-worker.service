[Unit]
Description=Bilibili Processor Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bilibili-processor
EnvironmentFile=/root/bilibili-processor/.env
ExecStart=/root/bilibili-processor/.venv/bin/python -m app.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
