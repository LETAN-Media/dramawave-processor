ENVIRONMENT=production
API_KEY=change-me

# Production: use external PostgreSQL/Supabase/Neon/etc.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/bilibili

WORKER_ID=vps-a
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=20
JOB_LEASE_SECONDS=180
STALE_JOB_MAX_AGE_HOURS=24

WORK_DIR=/tmp/bilibili-processor
PERSIST_ORIGINAL_VIDEO=true

# local | s3 | r2
STORAGE_PROVIDER=r2
LOCAL_STORAGE_DIR=/var/lib/bilibili-processor/storage

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=bilibili-processor
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional Netscape cookies.txt for videos that require authentication.
BILIBILI_COOKIES_FILE=

DOWNLOAD_FORMAT=bv*[height<=1080]+ba/b[height<=1080]/b
DOWNLOAD_FORMAT_FALLBACK=bv*[vcodec^=avc1][height<=480]+ba/b[height<=480]/b
DOWNLOAD_CONCURRENT_FRAGMENTS=4
HTTP_TIMEOUT_SECONDS=20

# Subtitle strategy: asr | bilibili | auto (default asr)
SUBTITLE_SOURCE_MODE=asr

# Chinese ASR (faster-whisper, CPU-only default)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
OMP_NUM_THREADS=4
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=true
WHISPER_LANGUAGE=zh
ASR_CONCURRENCY=1

# ASR provider: jianying | whisper | auto (default auto = JianYing then Whisper fallback)
ASR_PROVIDER=auto
ALLOW_REMOTE_ASR=true

# Translation (ToolNet OpenAI-compatible; key via TRANSLATION_API_KEY, never committed)
TRANSLATION_PROVIDER=toolnet
TRANSLATION_BASE_URL=https://api.toolnet.tech/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=alims-intl.llm
TRANSLATION_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
TRANSLATION_BATCH_SIZE=50
TRANSLATION_CONCURRENCY=3
TRANSLATION_TIMEOUT=120
TRANSLATION_MAX_RETRIES=3

# Vietnamese TTS (Edge default)
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_CONCURRENCY=6
TTS_MAX_RETRIES=3

JIANYING_ENABLED=true
JIANYING_MAX_RETRIES=2
JIANYING_UPLOAD_TIMEOUT=120
JIANYING_PROCESS_TIMEOUT=600
JIANYING_POLL_INTERVAL=2
JIANYING_CONCURRENCY=1

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

SRT_MIN_DURATION_MS=300
SRT_MAX_CHARS_PER_LINE=24
SRT_MAX_LINES=2

# Voice QA single source of truth
CPS_TARGET=20
QA_MAX_ROUNDS=2
QA_SEVERE_OVERFLOW_MS=250
QA_SEVERE_OVERFLOW_RATIO=0.10
