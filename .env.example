ENVIRONMENT=production
API_KEY=change-me

# DramaWave Studio dashboard auth (web UI). Leave both empty = open UI
# (single-user VPS). Set both to require login on all web pages.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Optional signing secret for the session cookie. Defaults to API_KEY when empty.
DASHBOARD_SECRET=

# Production: use external PostgreSQL/Supabase/Neon/etc.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dramawave

WORKER_ID=vps-a
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=20
JOB_LEASE_SECONDS=180
STALE_JOB_MAX_AGE_HOURS=24

WORK_DIR=/tmp/dramawave-processor

# local | s3 | r2
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/var/lib/dramawave-processor/storage

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dramawave-processor
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

HTTP_TIMEOUT_SECONDS=20

# Languages: source auto-detected per episode, target always Vietnamese
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=vi

# ASR routing: zh -> JianYing primary + Whisper fallback; others -> Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
OMP_NUM_THREADS=4
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=true
WHISPER_LANGUAGE=zh
ASR_CONCURRENCY=1

# ASR provider: jianying | whisper | auto (default auto)
ASR_PROVIDER=auto
ALLOW_REMOTE_ASR=true

JIANYING_ENABLED=true
JIANYING_MAX_RETRIES=2
JIANYING_UPLOAD_TIMEOUT=120
JIANYING_PROCESS_TIMEOUT=600
JIANYING_POLL_INTERVAL=2
JIANYING_CONCURRENCY=1

# Translation (ToolNet OpenAI-compatible; key via TRANSLATION_API_KEY, never committed)
TRANSLATION_PROVIDER=toolnet
TRANSLATION_BASE_URL=https://api.toolnet.tech/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=alims-intl.llm
TRANSLATION_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
TRANSLATION_BATCH_SIZE=50
TRANSLATION_CONCURRENCY=3
TRANSLATION_TIMEOUT=120
TRANSLATION_MAX_RETRIES=3
TRANSLATION_PRIMARY_FAILURE_THRESHOLD=1
TRANSLATION_PRIMARY_COOLDOWN_SECONDS=600
VOICE_QA_AI_TIMEOUT=20
VOICE_QA_PRIMARY_RETRIES=0
VOICE_QA_FALLBACK_RETRIES=2
VOICE_QA_MAX_ROUNDS=2

# Vietnamese TTS (Edge default)
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_CONCURRENCY=6
TTS_MAX_RETRIES=3

# DramaWave source (official H5 API; free episodes only, locked are skipped)
DRAMAWAVE_ENABLED=true
DRAMAWAVE_QUALITY=best
DRAMAWAVE_TIMEOUT=20
DRAMAWAVE_MAX_RETRIES=3
DRAMAWAVE_EPISODE_CONCURRENCY=2
DRAMAWAVE_MAX_REDIRECTS=5

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

SRT_MIN_DURATION_MS=300
SRT_MAX_CHARS_PER_LINE=24
SRT_MAX_LINES=2

# Voice QA single source of truth
CPS_TARGET=20
QA_MAX_ROUNDS=2
QA_SEVERE_OVERFLOW_MS=250
QA_SEVERE_OVERFLOW_RATIO=0.10

# Speech-block voice (SRT immutable; blocks are audio-only)
VOICE_BLOCK_MAX_GAP_MS=250
VOICE_BLOCK_TARGET_MS=4500
VOICE_BLOCK_MAX_MS=8000

# Google OAuth (YouTube upload). Values live only in .env, never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console, e.g.
# https://drama.toolnet.tech/auth/youtube/callback
YOUTUBE_REDIRECT_URI=
YOUTUBE_DEFAULT_PRIVACY=public
YOUTUBE_AUTO_UPLOAD=false
YOUTUBE_UPLOAD_CONCURRENCY=1
YOUTUBE_UPLOAD_INTERVAL_SECONDS=0
# Fernet key (generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=
